// The producer's test project for Osysharp.ShiftScheduling — a café: baristas who work the floor and the espresso bar, a
// trainee who never works alone, and a shift lead who builds the week. The espresso bar needs the café's own barista
// training, which the café answers; time is the café's own, in London.
app ShiftSchedulingKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.ShiftScheduling@0;
  use Osysharp.Ui;
  use Osysharp.Workflow;
}
